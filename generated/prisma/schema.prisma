// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// PRODUCT & INVENTORY MODELS
// ============================================

enum StockType {
  WEIGHT // For fresh produce (kg/g)
  UNIT // For processed/packaged items
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
  OUT_OF_STOCK // Legacy - kept for backward compatibility
  DISCONTINUED // Legacy - kept for backward compatibility
}

enum ProductType {
  FRESH
  FROZEN
  PROCESSED
  DRIED
  LIVE
}

enum SeafoodType {
  FISH
  SHELLFISH
  CRUSTACEAN
  MOLLUSK
  SEAWEED
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  image       String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([slug])
  @@index([parentId])
}

model Product {
  id               String  @id @default(cuid())
  name             String
  sku              String? @unique // Stock keeping unit (optional during migration)
  slug             String  @unique
  description      String?
  shortDescription String?

  // Seafood-specific attributes
  productType ProductType @default(FRESH) // fresh | frozen | processed | dried | live
  seafoodType SeafoodType @default(FISH) // fish | shellfish | crustacean | mollusk | seaweed
  speciesName String? // Scientific species name
  localName   String? // Filipino/local name (e.g., Bangus, Tilapia)

  // Pricing
  price          Decimal  @db.Decimal(10, 2) // Base selling price
  compareAtPrice Decimal? @db.Decimal(10, 2) // Original price for showing discounts
  costPerItem    Decimal? @db.Decimal(10, 2) // For profit calculations

  // Stock Management
  stockType     StockType @default(UNIT)
  stockQuantity Decimal   @db.Decimal(10, 3) // Supports both kg (e.g., 25.500) and units (e.g., 100.000)
  stockUnit     String    @default("kg") // kg | gram | piece | pack | box | tray
  minOrderQty   Decimal   @default(1) @db.Decimal(10, 3)
  maxOrderQty   Decimal?  @db.Decimal(10, 3)

  // Weight for shipping calculations (always in kg)
  weightKg Decimal @default(0) @db.Decimal(10, 3)

  // Cold Chain & Freshness
  requiresColdChain Boolean   @default(true) // Requires temperature-controlled shipping
  bestBefore        DateTime? // Best before date for current batch
  shelfLifeDays     Int? // Product freshness duration in days

  // Images
  images ProductImage[]

  // Relations
  categoryId     String
  category       Category         @relation(fields: [categoryId], references: [id])
  merchantId     String? // Producer/Merchant who owns this product
  merchant       Merchant?        @relation(fields: [merchantId], references: [id])
  variants       ProductVariant[]
  orderItems     OrderItem[]
  cartItems      CartItem[]
  bulkOrderItems BulkOrderItem[]
  quoteItems     QuoteItem[]

  // Metadata
  status   ProductStatus @default(DRAFT) // draft | active | inactive | archived
  featured Boolean       @default(false)
  tags     String[]      @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sku])
  @@index([slug])
  @@index([categoryId])
  @@index([merchantId])
  @@index([status])
  @@index([productType])
  @@index([seafoodType])
  @@index([featured])
  @@index([bestBefore])
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name        String // Variant name (500g, 1kg, whole, fillet)
  sku         String  @unique // Unique variant SKU
  price       Decimal @db.Decimal(10, 2) // Variant price
  weightValue Decimal @db.Decimal(10, 3) // Weight amount

  // Inventory
  stockQuantity     Int @default(0) // Available stock
  lowStockThreshold Int @default(10) // Alert threshold

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([sku])
}

// ============================================
// ORDER & CHECKOUT MODELS
// ============================================

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique @default(cuid())

  // Customer
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Items
  items OrderItem[]

  // Pricing
  subtotal     Decimal @db.Decimal(10, 2)
  shippingCost Decimal @db.Decimal(10, 2)
  tax          Decimal @default(0) @db.Decimal(10, 2)
  discount     Decimal @default(0) @db.Decimal(10, 2)
  total        Decimal @db.Decimal(10, 2)

  // Weight for shipping
  totalWeightKg Decimal @db.Decimal(10, 3)

  // Delivery
  deliveryDate     DateTime // Scheduled delivery date
  deliveryTimeSlot String? // e.g., "9:00 AM - 12:00 PM"
  deliveryNotes    String?

  // Shipping Address
  shippingAddress Json // { street, city, state, postalCode, country, phone }

  // Payment
  paymentStatus   PaymentStatus @default(PENDING)
  paymentMethod   String?
  paymentIntentId String? // Paymongo payment intent ID
  paymentSourceId String? // Paymongo source ID

  // Status
  status OrderStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([deliveryDate])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  // Snapshot of product at time of order
  productName  String
  productImage String?

  // Quantity & Pricing
  quantity   Decimal @db.Decimal(10, 3) // Supports weight-based orders
  unitType   String // "kg", "g", "unit", etc.
  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)
  weightKg   Decimal @db.Decimal(10, 3) // Total weight for this line item

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

// ============================================
// CART MODEL (Server-side persistence)
// ============================================

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  sessionId String? // For guest users
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([userId])
  @@index([sessionId])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Decimal  @db.Decimal(10, 3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
}

// ============================================
// SHIPPING CONFIGURATION
// ============================================

model ShippingZone {
  id        String         @id @default(cuid())
  name      String
  rates     ShippingRate[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model ShippingRate {
  id            String       @id @default(cuid())
  zoneId        String
  zone          ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  name          String // e.g., "Standard", "Express"
  minWeightKg   Decimal      @db.Decimal(10, 3)
  maxWeightKg   Decimal?     @db.Decimal(10, 3)
  basePrice     Decimal      @db.Decimal(10, 2)
  pricePerKg    Decimal      @db.Decimal(10, 2) // Additional cost per kg
  estimatedDays Int // Delivery time in days
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([zoneId])
}

// ============================================
// MERCHANT & PRODUCER MODELS
// ============================================

enum BusinessType {
  MSME
  FISHERY
  AQUACULTURE
  PROCESSOR
}

enum BusinessSize {
  MICRO
  SMALL
  MEDIUM
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum DocumentType {
  BUSINESS_PERMIT
  FDA_LICENSE
  BFAR_REGISTRATION
  SANITARY_PERMIT
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model Merchant {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Business Profile
  businessName               String
  businessRegistrationNumber String
  businessType               BusinessType
  businessSize               BusinessSize
  description                String?

  // Metrics
  ratingAverage Decimal @default(0) @db.Decimal(3, 2)
  totalSales    Int     @default(0)

  // Status
  verificationStatus VerificationStatus @default(PENDING)
  isFeatured         Boolean            @default(false)

  // Relations
  documents MerchantDocument[]
  products  Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([verificationStatus])
  @@index([businessType])
}

model MerchantDocument {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  documentType   DocumentType
  documentUrl    String?
  documentNumber String
  expiryDate     DateTime

  status DocumentStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([merchantId])
  @@index([status])
  @@index([expiryDate])
}

// ============================================
// AUTH MODELS (NextAuth)
// ============================================

enum UserRole {
  CUSTOMER
  MERCHANT
  PRODUCER
  ADMIN
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? // @db.Text
  access_token             String? // @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? // @db.Text
  session_state            String?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  refresh_token_expires_in Int?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  password      String? // Hashed password for credentials login
  role          UserRole  @default(CUSTOMER)

  // Default shipping address
  defaultAddress Json?

  accounts   Account[]
  sessions   Session[]
  orders     Order[]
  bulkOrders BulkOrder[]
  quotes     Quote[]
  merchant   Merchant? // For MERCHANT and PRODUCER roles

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// BULK ORDER & QUOTE MODELS
// ============================================

enum BulkOrderStatus {
  ORDER_PLACED // Just submitted by merchant
  PENDING_CONFIRMATION // Being reviewed by producer
  CONFIRMED // Producer confirmed the order
  AWAITING_PAYMENT // Waiting for merchant payment
  PAID // Payment confirmed
  PREPARING // Order is being prepared
  READY_FOR_SHIPMENT // Ready to be shipped
  IN_TRANSIT // Order is in transit
  DELIVERED // Order has been delivered
  COMPLETED // Merchant confirmed satisfaction
  DISPUTED // Merchant raised a dispute
  RESOLVED // Dispute resolved
  CANCELLED // Order was cancelled
}

enum ShippingCarrier {
  JT_EXPRESS // J&T Express
  LALAMOVE // Lalamove
  GRAB_EXPRESS // Grab Express
  LBC // LBC Express
  GOGO_XPRESS // GoGo Xpress
  NINJA_VAN // Ninja Van
  SELF_DELIVERY // Producer's own delivery
  OTHER // Other carrier
}

enum QuoteStatus {
  PENDING // Quote request submitted
  PROCESSING // Quote being prepared
  SENT // Quote sent to customer
  ACCEPTED // Customer accepted the quote
  REJECTED // Customer rejected the quote
  EXPIRED // Quote expired
}

model BulkOrder {
  id          String @id @default(cuid())
  orderNumber String @unique @default(cuid())

  // Customer
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Items
  items BulkOrderItem[]

  // Estimated pricing (before confirmation)
  estimatedSubtotal Decimal @db.Decimal(10, 2)
  estimatedTotal    Decimal @db.Decimal(10, 2)
  estimatedWeightKg Decimal @db.Decimal(10, 3)

  // Final pricing (after quote acceptance)
  finalSubtotal      Decimal? @db.Decimal(10, 2)
  finalShipping      Decimal? @db.Decimal(10, 2)
  finalTotal         Decimal? @db.Decimal(10, 2)
  coldChainSurcharge Decimal? @db.Decimal(10, 2) // Extra charge for cold chain shipping

  // Delivery preferences
  preferredDeliveryDate DateTime?
  deliveryNotes         String?

  // Contact information
  contactName     String
  contactEmail    String
  contactPhone    String
  companyName     String?
  shippingAddress Json? // { street, city, state, postalCode, country }

  // Status
  status BulkOrderStatus @default(ORDER_PLACED)
  notes  String? // Internal notes

  // Shipping & Tracking
  carrier           ShippingCarrier?
  carrierOther      String? // If carrier is OTHER, specify name
  trackingNumber    String?
  trackingUrl       String? // External tracking URL
  requiresColdChain Boolean          @default(false) // Does this order require cold chain?

  // Estimated delivery
  estimatedDeliveryDate DateTime?
  actualDeliveryDate    DateTime?

  // Payment (Paymongo)
  paymentStatus   String? // "pending" | "paid" | "failed"
  paymentMethod   String? // "paymongo"
  paymentIntentId String? // Paymongo checkout session ID
  paymentUrl      String? // Paymongo checkout URL (for retry)

  // Status timestamps (for tracking)
  pendingConfirmationAt DateTime?
  confirmedAt           DateTime?
  awaitingPaymentAt     DateTime?
  paidAt                DateTime?
  preparingAt           DateTime?
  readyForShipmentAt    DateTime?
  inTransitAt           DateTime?
  deliveredAt           DateTime?
  completedAt           DateTime?
  disputedAt            DateTime?
  resolvedAt            DateTime?
  cancelledAt           DateTime?

  // Dispute
  disputeReason     String?
  disputeResolution String?

  // Proof of delivery
  deliveryProofUrl  String? // Photo of delivered goods
  deliverySignature String? // Signature image URL
  receivedBy        String? // Name of person who received

  // Related quote
  quote Quote?

  // Status history
  statusHistory OrderStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
  @@index([trackingNumber])
  @@index([carrier])
}

model BulkOrderItem {
  id          String    @id @default(cuid())
  bulkOrderId String
  bulkOrder   BulkOrder @relation(fields: [bulkOrderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])

  // Snapshot of product at time of order
  productName  String
  productImage String?
  localName    String?
  productType  String
  seafoodType  String

  // Quantity & Pricing
  quantity   Decimal @db.Decimal(10, 3)
  unitType   String // "kg", "g", "unit", etc.
  unitPrice  Decimal @db.Decimal(10, 2) // Estimated unit price
  totalPrice Decimal @db.Decimal(10, 2) // Estimated total price
  weightKg   Decimal @db.Decimal(10, 3)

  // Final pricing (after negotiation)
  finalUnitPrice  Decimal? @db.Decimal(10, 2)
  finalTotalPrice Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([bulkOrderId])
  @@index([productId])
}

model Quote {
  id          String @id @default(cuid())
  quoteNumber String @unique @default(cuid())

  // Customer
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Related bulk order (optional - quote can be standalone)
  bulkOrderId String?    @unique
  bulkOrder   BulkOrder? @relation(fields: [bulkOrderId], references: [id])

  // Quote items (if standalone, otherwise references BulkOrderItems)
  items QuoteItem[]

  // Pricing
  subtotal      Decimal  @db.Decimal(10, 2)
  shippingCost  Decimal? @db.Decimal(10, 2)
  discount      Decimal  @default(0) @db.Decimal(10, 2)
  total         Decimal  @db.Decimal(10, 2)
  totalWeightKg Decimal  @db.Decimal(10, 3)

  // Contact information
  contactName  String
  contactEmail String
  contactPhone String
  companyName  String?

  // Quote validity
  validUntil DateTime
  status     QuoteStatus @default(PENDING)

  // Notes
  customerNotes String? // Notes from customer
  internalNotes String? // Internal notes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([quoteNumber])
  @@index([status])
  @@index([validUntil])
}

model QuoteItem {
  id        String  @id @default(cuid())
  quoteId   String
  quote     Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  // Product snapshot
  productName  String
  productImage String?
  localName    String?
  productType  String
  seafoodType  String

  // Quantity & Pricing
  quantity   Decimal @db.Decimal(10, 3)
  unitType   String
  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)
  weightKg   Decimal @db.Decimal(10, 3)

  createdAt DateTime @default(now())

  @@index([quoteId])
  @@index([productId])
}

// ============================================
// ORDER STATUS HISTORY (Audit Trail)
// ============================================

model OrderStatusHistory {
  id          String    @id @default(cuid())
  bulkOrderId String
  bulkOrder   BulkOrder @relation(fields: [bulkOrderId], references: [id], onDelete: Cascade)

  fromStatus BulkOrderStatus
  toStatus   BulkOrderStatus

  // Who made the change
  changedById   String
  changedByName String // Snapshot of user name at time of change
  changedByRole String // PRODUCER, MERCHANT, ADMIN

  // Additional info
  notes    String?
  metadata Json? // Any additional data (e.g., tracking info when shipped)

  createdAt DateTime @default(now())

  @@index([bulkOrderId])
  @@index([createdAt])
}
